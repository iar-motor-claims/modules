---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Modules - Modular Product Platform</title>
    <meta name="description" content="Selling everything as modules. A modular product platform for the modern era." />
  </head>
  <body class="bg-white dark:bg-slate-900 text-slate-900 dark:text-white">
    <header class="sticky top-0 z-50 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
        <div class="text-2xl font-bold">Modules</div>
        <div class="flex gap-6">
          <a href="#features" class="hover:text-blue-600">Features</a>
          <a href="#docs" class="hover:text-blue-600">Documentation</a>
          <a href="https://github.com/iar-motor-claims/modules" class="hover:text-blue-600">GitHub</a>
        </div>
      </nav>
    </header>

    <main>
      {/* Hero Section */}
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <div class="text-center">
          <h1 class="text-5xl font-bold mb-6">Selling Everything as Modules</h1>
          <p class="text-xl text-slate-600 dark:text-slate-400 mb-8">
            A modular product platform built for scale, flexibility, and growth
          </p>
          <div class="flex gap-4 justify-center">
            <a href="https://github.com/iar-motor-claims/modules" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg">
              View on GitHub
            </a>
            <a href="#features" class="border-2 border-blue-600 hover:bg-blue-50 dark:hover:bg-slate-800 text-blue-600 px-6 py-3 rounded-lg">
              Learn More
            </a>
          </div>
        </div>
      </section>

      {/* Features Section */}
      <section id="features" class="bg-slate-50 dark:bg-slate-800 py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-3xl font-bold mb-12 text-center">Platform Features</h2>
          <div class="grid md:grid-cols-3 gap-8">
            <div class="bg-white dark:bg-slate-900 p-6 rounded-lg border border-slate-200 dark:border-slate-700">
              <h3 class="text-xl font-bold mb-4">Modular Architecture</h3>
              <p class="text-slate-600 dark:text-slate-400">
                Built with a three-tier architecture: shared libraries, services, and tools.
              </p>
            </div>
            <div class="bg-white dark:bg-slate-900 p-6 rounded-lg border border-slate-200 dark:border-slate-700">
              <h3 class="text-xl font-bold mb-4">Enterprise CI/CD</h3>
              <p class="text-slate-600 dark:text-slate-400">
                Integrated with monorepo_nx_pipeline for automated builds and deployments.
              </p>
            </div>
            <div class="bg-white dark:bg-slate-900 p-6 rounded-lg border border-slate-200 dark:border-slate-700">
              <h3 class="text-xl font-bold mb-4">Cloud Ready</h3>
              <p class="text-slate-600 dark:text-slate-400">
                Deploy to Kubernetes, GKE, or Cloudflare with industry-standard tooling.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* Documentation Section */}
      <section id="docs" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <h2 class="text-3xl font-bold mb-8">Getting Started</h2>
        <div class="prose dark:prose-invert max-w-none">
          <h3>Quick Setup</h3>
          <pre><code>{`# Clone the repository
git clone git@github.com:iar-motor-claims/modules.git
cd modules

# Install dependencies
pnpm install

# Development
pnpm dev

# Build for production
pnpm build`}</code></pre>

          <h3>Documentation</h3>
          <ul>
            <li><a href="https://github.com/iar-motor-claims/modules">GitHub Repository</a></li>
            <li><a href="https://nx.dev">Nx Documentation</a></li>
            <li><a href="https://pnpm.io">pnpm Documentation</a></li>
          </ul>
        </div>
      </section>
    </main>

    <footer class="bg-slate-900 text-white border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex justify-between items-center">
          <div>
            <p class="text-slate-400">© 2025 IAR Motor Claims. All rights reserved.</p>
          </div>
          <div class="flex gap-6">
            <a href="https://github.com/iar-motor-claims/modules" class="text-slate-400 hover:text-white">GitHub</a>
            <a href="https://iarservices.in" class="text-slate-400 hover:text-white">Home</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
