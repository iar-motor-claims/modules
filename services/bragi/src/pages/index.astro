---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <header class="border-b border-slate-200">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
      <span class="text-xl font-bold">Modules</span>
      <a
        href="https://github.com/iar-motor-claims/modules"
        class="text-sm font-medium text-slate-600 hover:text-slate-900"
      >
        GitHub
      </a>
    </nav>
  </header>

  <main class="mx-auto max-w-6xl px-6">
    <section class="py-24 text-center">
      <h1 class="text-5xl font-bold tracking-tight sm:text-6xl">
        Composable modules for AI &amp; business
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
        Buy what you need. Each capability ships as an independent, deployable
        module you can license on its own or bundle together.
      </p>
    </section>
  </main>

  <footer class="border-t border-slate-200">
    <div class="mx-auto max-w-6xl px-6 py-8 text-sm text-slate-500">
      © 2025 IAR Services. All rights reserved.
    </div>
  </footer>
</BaseLayout>
